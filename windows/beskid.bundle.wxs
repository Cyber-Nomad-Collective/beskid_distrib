<?xml version='1.0' encoding='utf-8'?>
<!--
  WiX Burn bootstrapper: vendor prerequisites are remote, locked payloads.

  Variables (-d):  Version  MsiPath  AssetsDir

  beskid.exe, beskid_lsp.exe, beskid-up.exe, the ABI-v5 runtime DLL, and the
  executables that `beskid build` links import VCRUNTIME140.dll. The bundle
  downloads Microsoft's redistributable and runs it only
  when the machine lacks a 14.40 or newer x64 runtime. The package is
  permanent: uninstalling Beskid never removes a runtime other software shares.

  The developer packages are gated by InstallDeveloperTools, defaulting to 0.
-->
<Wix xmlns='http://wixtoolset.org/schemas/v4/wxs'
     xmlns:bal='http://wixtoolset.org/schemas/v4/wxs/bal'
     xmlns:util='http://wixtoolset.org/schemas/v4/wxs/util'>
  <Bundle
    Name='Beskid'
    Manufacturer='Cyber Nomad Collective'
    Version='$(var.Version)'
    IconSourceFile='$(var.AssetsDir)\icons\beskid.ico'
    UpgradeCode='68111af0-f0f1-4d30-bcc3-c52ea3166819'>
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        LicenseUrl='https://www.apache.org/licenses/LICENSE-2.0'
        Theme='hyperlinkLicense'
        ThemeFile='$(var.DistribRoot)\windows\beskid-theme.xml'
        LocalizationFile='$(var.DistribRoot)\windows\beskid-theme.wxl'
        LogoFile='$(var.AssetsDir)\icons\beskid-512.png' />
    </BootstrapperApplication>
    <Variable Name='InstallDeveloperTools' Type='numeric' Value='0' bal:Overridable='yes' />

    <!-- The runtime writes these values under the 64-bit registry view. -->
    <util:RegistrySearch
      Id='VcRedistX64InstalledSearch'
      Variable='VcRedistX64Installed'
      Root='HKLM'
      Key='SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64'
      Value='Installed'
      Result='value'
      Bitness='always64' />

    <!-- Skip already installed standard-path developer tools. Their vendor
         bootstrappers are not idempotent install commands. -->
    <util:FileSearch
      Id='VsBuildToolsInstalledSearch'
      Variable='VsBuildToolsInstalled'
      Path='[ProgramFilesFolder]Microsoft Visual Studio\2022\BuildTools\Common7\Tools\VsDevCmd.bat'
      Result='exists' />
    <util:FileSearch
      Id='LlvmX64InstalledSearch'
      Variable='LlvmX64Installed'
      Path='[ProgramFiles64Folder]LLVM\bin\lld-link.exe'
      Result='exists' />
    <util:RegistrySearch
      Id='VcRedistX64MinorSearch'
      After='VcRedistX64InstalledSearch'
      Variable='VcRedistX64Minor'
      Root='HKLM'
      Key='SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64'
      Value='Minor'
      Result='value'
      Bitness='always64' />

    <Chain>
      <PackageGroupRef Id='VcRedistX64Group' />
      <PackageGroupRef Id='VsBuildTools2022Group' />
      <PackageGroupRef Id='LlvmX64Group' />
      <MsiPackage SourceFile='$(var.MsiPath)' />
    </Chain>
  </Bundle>
</Wix>
