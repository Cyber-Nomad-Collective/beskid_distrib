  <String Id="HelpHeader" Value="Setup Help" />
  <String Id="HelpText" Value="/install | /repair | /uninstall - installs, repairs, or uninstalls Beskid.&#xA;/quiet - runs without prompts.&#xA;InstallDeveloperTools=1 - also downloads MSVC Build Tools, Windows SDK, and LLVM.&#xA;/norestart - prevents an automatic restart.&#xA;/log log.txt - writes the setup log to the chosen file." />
